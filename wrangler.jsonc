{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noahflow-personal",
  "main": "workers/index.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "send_metrics": false,
  "observability": {
    "enabled": false,
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/auth",
      "/auth/*",
      "/webhooks",
      "/webhooks/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noahflow-personal",
      "migrations_dir": "migrations",
    },
  ],
  "secrets": {
    "required": ["ADMIN_PASSWORD"],
  },
}
