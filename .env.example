# Optional local-only file. Never commit a real .env or put credentials in chat.
# Codespaces: prefer repository-scoped Codespaces secrets; restart after adding them.
INSTAGRAM_LOGIN_MODE=instagram
# Use a supported explicit version shown by your Meta app, e.g. the vNN.N format.
INSTAGRAM_API_VERSION=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Only needed for the separate receive-only webhook process.
META_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
